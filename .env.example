# Copy to .env at the repository root. No model key is needed for the website demo.
# Visitors add their own keys in /connections. These legacy provider settings
# never supply keys to public visitor runs.
LLM_PROVIDER=demo

# Required on Vercel / production. Keep the same secret across deployments.
# Generate privately for a new installation: openssl rand -hex 32
RELAY_SECRET=

# Required on Vercel. Use a pooled Postgres URL. Leave empty locally for PGlite.
DATABASE_URL=
# Relative to the web process; the default becomes web/data/pglite.
PGLITE_DIR=data/pglite

LEASE_TTL_MS=30000
DEMO_FAILURE_RATE=0

# Optional legacy library-level provider configuration; see docs/CONFIGURATION.md.
# Supported: demo, gemini, groq, cerebras, openrouter.
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=
LLM_RPM=
SEARCH_ENABLED=false
PRICE_INPUT_PER_M=0
PRICE_OUTPUT_PER_M=0
PRICE_SEARCH_PER_K=0

# Optional local agent demo overrides; authenticate CLIs separately.
# RELAY_AGENT_CWD=
# RELAY_PI_MODEL=
# RELAY_PI_PROVIDER=
# RELAY_CLAUDE_MODEL=
# RELAY_CODEX_MODEL=
