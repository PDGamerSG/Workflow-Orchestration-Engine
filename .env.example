# Copy to .env and fill in. Only the key of the provider you pick is required.

# gemini, groq, cerebras, openrouter, or demo (no key, scripted replies).
LLM_PROVIDER=groq

# Free keys: https://console.groq.com/keys, https://cloud.cerebras.ai,
# https://openrouter.ai/keys, https://aistudio.google.com/apikey
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Leave empty for the provider's default free model:
# groq openai/gpt-oss-120b, cerebras gpt-oss-120b,
# openrouter nvidia/nemotron-3-super-120b-a12b:free, gemini gemini-3.5-flash.
LLM_MODEL=

# Requests per minute, shared by every run in the process. Leave empty for the
# provider's free-tier limit (groq 30, cerebras 30, openrouter 20, gemini 60).
# The Gemini free tier allows 5.
LLM_RPM=

# Only Gemini has a search tool. Set to false for keys without Google Search grounding quota.
SEARCH_ENABLED=true

# With LLM_PROVIDER=demo, the share of step calls that fail like an overloaded API.
# Planner calls never fail, so retries, re-plans and skips show up in the dashboard.
DEMO_FAILURE_RATE=0

# How long another worker waits before taking over a dead worker's runs.
LEASE_TTL_MS=30000

# Postgres connection string. On Vercel, connecting a Neon database sets it for you.
# Leave empty locally to store runs in PGlite under web/data/pglite.
DATABASE_URL=
