# Copy to .env and fill in. Only GOOGLE_API_KEY is required, and only for the gemini provider.
GOOGLE_API_KEY=

# Use LLM_PROVIDER=demo to run the whole stack without a key.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash

# Requests per minute, shared by every run in the process. The Gemini free tier allows 5.
GEMINI_RPM=60

# Set to false for keys without Google Search grounding quota.
SEARCH_ENABLED=true

# How long another worker waits before taking over a dead worker's runs.
LEASE_TTL_MS=30000

DATABASE_PATH=data/relay.db
PORT=4000
WEB_ORIGIN=http://localhost:3000
