{
  "name": "relay",
  "private": true,
  "packageManager": "bun@1.4.4",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "overrides": {
    "zod": "4.6.7"
  },
  "scripts": {
    "dev": "bun --filter '@relay/web' dev",
    "test": "bun --filter '*' test",
    "typecheck": "bun --filter '*' typecheck",
    "bench": "bun --filter '@relay/server' bench",
    "demo:crash": "bun --filter '@relay/server' demo:crash",
    "demo:agents": "bun server/scripts/agents-demo.ts",
    "build": "bun --filter '@relay/web' build",
    "lint": "bun --filter '@relay/web' lint"
  }
}
